# SMPL station kiosk configuration.
#
# Installed to /etc/smpl-station/kiosk.env by
#   sudo install-pi.sh --with-kiosk
# which never overwrites an existing one. Read by /usr/local/bin/smpl-kiosk.sh
# as a shell fragment, so: KEY=value, no spaces around the '=', '#' comments.
#
# Nothing here takes effect until the desktop session restarts:
#
#   pkill -f smpl-kiosk.sh ; pkill -f -- --user-data-dir=.*smpl-kiosk
#   /usr/local/bin/smpl-kiosk.sh &
#
# or just reboot, which is what to do if you are not sure.
#
# See what a change would do without doing it:
#
#   SMPL_KIOSK_DRYRUN=1 /usr/local/bin/smpl-kiosk.sh
#
#
# ===========================================================================
# THE TWO LINES THAT SWAP THE SCREENS
# ===========================================================================
#
# If the racks page is showing on the screen facing the boxes, swap the two
# values below. That is the entire fix. There is no code change, no rebuild,
# no reinstall, and nothing in the repository needs to know which way round
# the office is:
#
#   KIOSK_REGAL_OUTPUT=HDMI-A-2
#   KIOSK_KISTEN_OUTPUT=HDMI-A-1
#
# (and swap KIOSK_REGAL_SCALE / KIOSK_KISTEN_SCALE with them, since the scale
# belongs to the panel, not to the page.)
#
# Which connector is which socket has not been checked on this Pi and is not
# worth guessing at. Ask the box:
#
#   WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 wlr-randr
#
# It prints each connector with the make and model of the monitor on it, so
# "HDMI-A-2 is the Samsung" is something you read rather than deduce.


# --- which screen shows what --------------------------------------------
# Connector names as wlr-randr prints them.
#
# Today on this station:
#   HDMI-A-1  Philips TV, 1360x768   - the small screen, carries the taskbar
#   HDMI-A-2  Samsung U28E590, 4K30  - the large screen
KIOSK_REGAL_OUTPUT=HDMI-A-1
KIOSK_KISTEN_OUTPUT=HDMI-A-2

# The pages. Both are served by the station itself on 127.0.0.1, so they work
# with the office network unplugged - which is the point of the whole box.
#
# KEEP THEM ON 127.0.0.1. The routes these pages write through (/scan/route,
# /screen/action, /box/*, /rack/movement) are refused for any caller that is
# not this machine, because the agent listens on 0.0.0.0 so a phone can reach
# /setup. Point a page at http://smpl-station.local:8765/regal instead and it
# loads perfectly - and then every scan and every tap comes back
#   403 this route is local-only
# because the request now arrives from the Pi's LAN address rather than from
# loopback. Reads (/screen/state, /boxes/state) would keep working, so the
# screen looks alive and books nothing. Nobody has ever debugged that quickly.
KIOSK_REGAL_URL=http://127.0.0.1:8765/regal
KIOSK_KISTEN_URL=http://127.0.0.1:8765/kisten

# There is no knob here for what the rack screen books or for who it books it
# to. The direction (Ausgabe / Rückgabe / Wareneingang) and the name that an
# Ausgabe is booked to are chosen at the screen itself - by the command
# barcodes on the card next to the scanner, or by a tap - and the name clears
# itself after 120 seconds of nothing happening. They are decisions somebody
# makes per booking, not settings a config file should be able to pin.

# Chromium's device scale factor per window - how big everything is drawn.
# This is not the compositor's scale: it changes rendering inside the window
# and leaves the window's pixel geometry alone, which is what keeps the
# per-screen placement arithmetic honest.
#
# 1 on the 1360x768 Philips; 2 on the 4K Samsung, where scale 1 gives you a
# stock list you cannot read from the far side of the workshop. Fractional
# values (1.5, 1.25) work.
KIOSK_REGAL_SCALE=1
KIOSK_KISTEN_SCALE=2


# --- how the windows are placed ------------------------------------------
# x11 (default) or wayland.
#
# x11 runs Chromium through XWayland. XWayland gives labwc's two outputs one
# root window spanning both of them, so --window-position addresses an
# absolute desktop coordinate and the window lands where it was told. This is
# the only mode that places windows without help from the compositor, which
# is why it is the default on a Wayland session.
#
# wayland runs Chromium natively. It is cleaner - no X server in the path -
# but on Wayland a client cannot choose its own output, so this mode places
# nothing by itself: it launches each window with a distinct app_id
# (smpl-kiosk-regal, smpl-kiosk-kisten) and expects labwc window rules with
# MoveToOutput actions in ~/.config/labwc/rc.xml to do the placing. The script
# prints the exact rules it expects and does NOT write rc.xml. Untested on
# this station; treat it as documented, not delivered.
KIOSK_BACKEND=x11

# kiosk (default) or window.
#
# kiosk passes --kiosk: Chromium goes fullscreen on the monitor its initial
# --window-position put it on.
#
# window drops --kiosk and relies on --window-position/--window-size alone to
# cover the output exactly. Chromium is frameless either way because of
# --app=. Switch to this if a window insists on fullscreening onto the wrong
# screen - it is the deterministic fallback, at the cost of a window that a
# stray Super+drag could move.
KIOSK_FULLSCREEN=kiosk


# --- startup timing -------------------------------------------------------
# The kiosk waits for the station to answer 200 on this before opening a
# browser, so nobody ever sees "site cannot be reached" on a wall screen.
KIOSK_HEALTH_URL=http://127.0.0.1:8765/health

# Seconds to wait for that 200. Generous: at boot the venv is cold and the SD
# card is busy. On timeout the windows open anyway and the page retries.
KIOSK_HEALTH_TIMEOUT=180

# Seconds to wait for a named output to appear. A TV can take several seconds
# to negotiate HDMI after the Pi is already up. If an output is still missing
# when this expires the kiosk stops with an error and opens NOTHING - it will
# not put both pages on the one screen that did come up.
KIOSK_OUTPUT_TIMEOUT=60

# Seconds before a window that died is restarted. Each window is respawned
# independently, forever.
KIOSK_RESPAWN_DELAY=3


# --- rarely touched -------------------------------------------------------
# Which browser. Empty means: first of chromium, chromium-browser,
# google-chrome-stable found on PATH.
#KIOSK_CHROMIUM=/usr/bin/chromium

# Where the two Chromium profiles live. They MUST be different directories -
# a second Chromium against the same profile does not start a second browser,
# it hands its URL to the first one and exits, and you end up with one window
# wondering where the other went. The script derives <root>/regal and
# <root>/kisten from this.
#KIOSK_PROFILE_ROOT=/home/pi/.local/share/smpl-kiosk
