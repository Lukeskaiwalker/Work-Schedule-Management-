# Single Caddyfile that handles every flavour of how this stack is fronted:
#   - Local dev: HTTPS via tls internal (browser sees self-signed but trustable)
#   - Behind Traefik in prod: plain HTTP on :80, Traefik does Let's Encrypt
#
# Maintenance mode is toggled by the existence of /srv/maintenance/.flag.
# The Caddy `file` matcher evaluates per request, so creating or removing
# that file flips the page instantly — no reload, no restart, no dropped
# connections.

(spa_routing) {
	encode gzip

	# Maintenance mode: when /srv/maintenance/.flag exists, every request
	# is served the maintenance page with no-store cache headers and a
	# Retry-After hint so well-behaved clients back off.
	#
	# The `file` matcher resolves try_files relative to its own `root`, not
	# the surrounding site root, which is why we scope it explicitly here.
	# Without the inner root, the matcher would join /srv/maintenance/.flag
	# against /srv/web (the site root set further down) and never find it.
	@maintenance file {
		root /srv/maintenance
		try_files /.flag
	}
	handle @maintenance {
		header Cache-Control "no-store, must-revalidate"
		header Retry-After "120"
		rewrite * /index.html
		root * /srv/maintenance
		file_server
	}

	# API reverse proxy and SPA fallback are wrapped in mutually-exclusive
	# `handle` blocks. This matters: Caddy auto-orders directives by its
	# standard list, and `try_files` runs *before* `reverse_proxy`. Without
	# `handle`, `try_files {path} /index.html` would see /api/* doesn't
	# exist on disk and rewrite to /index.html *before* the reverse_proxy
	# matcher fires — every API call would silently fall through to the
	# SPA. `handle` blocks short-circuit, so a request that matches the
	# API handler never visits the SPA handler.
	#
	# SMPL_API_UPSTREAM is overrideable for tests but defaults to the
	# docker-network address of the api service.
	handle /api* {
		reverse_proxy {$SMPL_API_UPSTREAM:api:8000}
	}

	handle {
		# SPA static files. Vite emits content-hashed filenames in /assets/
		# and /chunks/, so those can be cached aggressively (a new build =
		# a new filename, so no risk of stale references).
		root * /srv/web

		# Security response headers for the served app. The CSP is the main
		# XSS backstop: script-src 'self' is safe because the built index.html
		# has no inline scripts (Vite emits an external module bundle).
		#   - style-src allows 'unsafe-inline' for React/Leaflet inline styles.
		#   - img-src allows https: so OSM tiles and the manufacturer-CDN
		#     catalog-image redirects keep loading.
		#   - frame-src allows 'self' (wiki/file preview), blob: (the in-app file
		#     viewer frames a PDF from an object URL) + Google Maps embeds.
		#   - frame-ancestors 'self' + X-Frame-Options block clickjacking from
		#     other origins while still permitting our own preview frame.
		# HSTS is intentionally NOT set here: in prod Traefik terminates TLS and
		# forwards plain HTTP to this container, so add Strict-Transport-Security
		# as a Traefik headers middleware at the TLS edge instead.
		#
		# Why blob: and 'self' rather than the tighter pair they replaced
		# ---------------------------------------------------------------
		# The in-app viewer fetches a file with its bearer token, wraps the bytes
		# in an object URL and frames it. Two different directives broke that, one
		# per engine, which is why fixing either alone left half the users stuck:
		#
		#   Chromium  frame-src 'self' does not match a blob: URL, so the frame
		#             was refused outright (securitypolicyviolation, blockedURI
		#             "blob"). Fixed by the blob: token.
		#   WebKit    frame-src 'self' DOES match a same-origin blob:, so that was
		#             never the problem on iPhones. A blob: document has no
		#             headers of its own and inherits the creating document's
		#             policy — including frame-ancestors 'none', which then
		#             forbids the only ancestor it will ever have, its own parent.
		#             Measured on iOS 26.5: adding blob: to frame-src changed
		#             nothing; frame-ancestors 'self' alone made the PDF render.
		#
		# Nothing that guards against stored XSS is relaxed. Framing is narrowed
		# to our own origin rather than opened up, third-party framing stays
		# blocked, and object-src / media-src / worker-src are untouched. A framed
		# blob is only ever reached for application/pdf (NativeFileViewer branches
		# on the type), and a blob typed application/pdf renders as an empty
		# document rather than executing markup even if the bytes are HTML.
		#
		# The API already made this exact change to its own file responses in
		# 7fdda3b for the same reason; this is the SPA half that was missed.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://nominatim.openstreetmap.org; frame-src 'self' blob: https://maps.google.com https://www.google.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
			X-Content-Type-Options "nosniff"
			# SAMEORIGIN, not DENY: browsers ignore X-Frame-Options entirely when
			# CSP frame-ancestors is present, but leaving DENY here would state
			# the opposite of the CSP one line above and mislead the next reader.
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
			-Server
		}

		@hashed path /assets/* /chunks/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html and the service worker MUST revalidate every load —
		# they point at the hashed asset filenames, so a cached copy can
		# leave the browser referencing ghost files after a deploy.
		# no-cache means "always revalidate" (a cheap 304 round-trip),
		# not "don't store".
		@nocache path /index.html /sw.js
		header @nocache Cache-Control "no-cache"

		# SPA fallback: client-side routes like /admin, /time, /planning
		# fall through to index.html so React Router can take over.
		try_files {path} /index.html
		file_server
	}
}

{
	auto_https disable_redirects
}

# Local dev: terminate TLS with an internal cert. The HTTP listener below
# upgrades to HTTPS so http://localhost still works.
https://localhost, https://127.0.0.1, https://[::1] {
	tls internal
	import spa_routing
}

http://localhost, http://127.0.0.1, http://[::1] {
	redir https://{host}{uri}
}

# Public site — Caddy obtains and renews the Let's Encrypt certificate itself.
#
# Until 2026-08 a shared Traefik at the household edge terminated TLS and
# forwarded plain HTTP here, and this file had no public site at all. Moving
# the server to the office leaves that proxy behind, so the TLS termination
# it was doing has to happen here instead. Caddy needs no configuration for
# that beyond naming the host: it solves the ACME challenge on :80 ahead of
# the routes below, and stores the certificate in the caddy_data volume so a
# restart does not re-issue.
#
# The domain is an env var with a default so it can be repointed without
# rebuilding the image, which matters because the Caddyfile is baked in.
#
# Requires ports 80 AND 443 reachable from the internet: 80 for the ACME
# HTTP-01 challenge, 443 to serve. Until both are forwarded, this host simply
# has no certificate and the plain-HTTP block below carries LAN traffic.
{$SMPL_PUBLIC_DOMAIN:smpl-office.duckdns.org} {
	import spa_routing

	# Set here now that this is the TLS terminator. It used to be a Traefik
	# label, because a header set behind a proxy on plain HTTP is ignored by
	# browsers. One year, subdomains included, not preloaded.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Plain-HTTP listener. Two jobs, and the second one is why it stays.
#
#  1. It carried all real traffic under the Traefik setup.
#  2. It is the local fallback: reaching the server by LAN address over HTTP
#     serves the app whatever the state of DNS, port forwarding or the
#     certificate. On a freshly moved machine that is the difference between
#     "the office can work" and "nobody can do anything until the router is
#     configured" — and the public name cannot be that fallback, because it
#     has carried HSTS for a year and browsers will refuse it over HTTP.
http:// {
	import spa_routing
}
